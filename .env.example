# ==============================================================================
# Route 3D — Variables de Entorno (Desarrollo / Producción)
# ==============================================================================

# Entorno: development | production
NODE_ENV=production
PORT=4000

# Mapbox Public Access Token
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/routevisualizer?retryWrites=true&w=majority

# Secreto JWT (OBLIGATORIO en PRO: usa al menos 32 caracteres aleatorios)
JWT_SECRET=genera_un_secreto_aleatorio_muy_largo_de_al_menos_32_caracteres
JWT_EXPIRES_IN_SECONDS=604800
MIN_PASSWORD_LENGTH=8

# ==============================================================================
# SEGURIDAD Y PRIVACIDAD PARAMÉTRICA (Por defecto todo privado / solo login)
# ==============================================================================

# Solo login: impide que desconocidos creen cuentas nuevas (false en PRO)
ALLOW_PUBLIC_REGISTRATION=false

# Desactiva accesos rápidos y listado de usuarios demo (false en PRO)
ENABLE_DEMO_LOGIN=false

# Sembrado automático / endpoint reseed (false en PRO)
ENABLE_AUTO_SEED=false
ALLOW_RESEED_ENDPOINT=false

# Privacidad paramétrica de datos: private | shared (por defecto: private)
DATA_PRIVACY_ROUTES=private
DATA_PRIVACY_PLANNED_ROUTES=private
DATA_PRIVACY_SEGMENTS=private
DATA_PRIVACY_HEATMAP=private
DATA_PRIVACY_WATER_SOURCES=private

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=https://tu-dominio-pro.com,http://localhost:5173

# Rate limiting (protección contra fuerza bruta y abuso)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=15
